{
  // ===========================================================================
  // Dev Container Configuration — ROS2 Jazzy (Native Linux / Docker)
  // Purpose: Defines the VS Code Dev Container environment for ROS2 development.
  //          VS Code reads this file to build/start the container and configure
  //          the editor automatically when "Reopen in Container" is selected.
  //
  // NOTE: Native Linux Docker talks to the kernel directly (no VM layer like
  //       Docker Desktop on macOS uses), so USB and X11 device access is
  //       direct — no passthrough tricks needed.
  // ===========================================================================
  "name": "ROS2 Jazzy",

  // ---------------------------------------------------------------------------
  // Build Configuration
  // ---------------------------------------------------------------------------
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // ---------------------------------------------------------------------------
  // Workspace Mount Override
  // ---------------------------------------------------------------------------
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // ---------------------------------------------------------------------------
  // Container Run Arguments
  // Purpose: Pass extra flags to `docker run` when the container starts:
  //   --device:      Direct passthrough of the OpenRB-150's serial device.
  //                  On native Linux there's no VM in between, so this just
  //                  works as long as the device is plugged in when the
  //                  container starts.
  //   --group-add:   Adds the container process to the host's 'dialout' GID
  //                  so the in-container user can read/write the serial
  //                  device. Unlike rootless Podman, Docker doesn't have a
  //                  'keep-groups' shortcut, so we pass the GID explicitly.
  //                  Find it on your host with: getent group dialout
  //   --network:     'host' avoids any docker.internal networking dance —
  //                  the container shares the host's network stack directly,
  //                  so X11/DISPLAY forwarding just works.
  //   -e DISPLAY:    Forwarded from the host's actual $DISPLAY via containerEnv
  //                  below rather than hardcoded, since native Linux X11
  //                  displays aren't always :0.
  //   --rm / --name
  // ---------------------------------------------------------------------------
  "runArgs": [
    "--device=/dev/ttyACM0",
    "--group-add=dialout",
    "--network=host",
    "-e", "TZ=Australia/Melbourne",
    "--rm",
    "--name", "ros2_jazzy"
  ],

  // ---------------------------------------------------------------------------
  // Container Environment
  // Purpose: Pass the host's DISPLAY through, and mount the X11 socket so
  //          GUI apps (RViz, Gazebo, rqt) can render on your native X server.
  //          No XQuartz/VirtualGL needed — this is a real Linux X server.
  // ---------------------------------------------------------------------------
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],

  // ---------------------------------------------------------------------------
  // Default Remote User
  // ---------------------------------------------------------------------------
  "remoteUser": "jazzy",

  // ---------------------------------------------------------------------------
  // Post-Create Command
  // ---------------------------------------------------------------------------
  "postCreateCommand": "sudo chown -R $(whoami) ${containerWorkspaceFolder}/",

  // ---------------------------------------------------------------------------
  // VS Code Extensions
  // ---------------------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "Ranch-Hand-Robotics.rde-pack",
        "Ranch-Hand-Robotics.rde-ros-2",
        "Ranch-Hand-Robotics.urdf-editor",
        "twxs.cmake",
        "ms-vscode.cmake-tools",
        "redhat.vscode-xml",
        "ms-python.python",
        "njpwerner.autodocstring",
        "ms-python.autopep8",
        "ms-python.pylint",
        "formulahendry.code-runner",
        "cschlosser.doxdocgen",
        "wayou.vscode-todo-highlight"
      ],

      "settings": {
        "ROS2.distro": "jazzy",
        "python.autoComplete.extraPaths": [
          "/opt/ros/jazzy/lib/python3.12/site-packages",
          "/opt/ros/jazzy/local/lib/python3.12/dist-packages",
          "/workspaces/${localWorkspaceFolderBasename}/install/interfaces/lib/python3.12/site-packages"
        ],
        "python.analysis.extraPaths": [
          "/opt/ros/jazzy/lib/python3.12/site-packages",
          "/opt/ros/jazzy/local/lib/python3.12/dist-packages",
          "/workspaces/${localWorkspaceFolderBasename}/install/interfaces/lib/python3.12/site-packages"
        ],
        "C_Cpp.default.includePath": [
          "/opt/ros/jazzy/include/**",
          "/workspaces/${localWorkspaceFolderBasename}/install/interfaces/include/**",
          "/workspaces/${localWorkspaceFolderBasename}/src/dxl_test/include/**",
          "/workspaces/${localWorkspaceFolderBasename}/src/my_robot_hardware/include/**"
        ],
        "C_Cpp.default.compilerPath": "/usr/bin/g++",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",

        "editor.fontSize": 25,
        "terminal.integrated.fontSize": 15,

        "editor.rulers": [100],

        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "ms-python.autopep8",
          "editor.tabSize": 4,
          "editor.insertSpaces": true
        },

        "[cpp]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        },

        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,

        "autopep8.args": [
          "--max-line-length",
          "100",
          "--aggressive"
        ],

        "code-runner.fileDirectoryAsCwd": true,
        "code-runner.saveFileBeforeRun": true,
        "code-runner.showExecutionMessage": true,
        "code-runner.clearPreviousOutput": true,
        "code-runner.runInTerminal": true,

        "explorer.confirmDelete": true,

        "workbench.settings.applyToAllProfiles": []
      }
    }
  }
}
